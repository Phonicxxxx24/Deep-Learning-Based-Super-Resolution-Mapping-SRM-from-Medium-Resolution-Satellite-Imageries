# ==============================================================================
# SRM (Super-Resolution Mapping) - Environment Variables Configuration
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES (Railway / Docker / Local FastAPI)
# ──────────────────────────────────────────────────────────────────────────────

# Port for Uvicorn server (automatically injected by Railway)
PORT=8000

# Allowed CORS Origins (comma-separated list of origins)
# Netlify domains (*.netlify.app) and Railway domains (*.railway.app) are already
# allowed by default. Add custom domains or specific URLs here.
# Example: https://my-srm-app.netlify.app,https://my-custom-domain.com
CORS_ORIGINS=https://localhost:3000,http://127.0.0.1:3000

# Persistent storage paths (defaults to local data and outputs folders)
# In Railway: mount persistent volumes at /app/data and /app/outputs
DATA_DIR=data
OUTPUT_DIR=outputs

# Optional CARTO Basemaps API Key for dark_matter tiles
CARTO_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES (Netlify / Next.js)
# ──────────────────────────────────────────────────────────────────────────────

# Public URL of the deployed Railway backend (NO trailing slash)
# Example: https://srm-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
